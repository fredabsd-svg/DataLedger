# Copie este arquivo para .env e ajuste os valores para o seu ambiente.
# Nunca commitar o arquivo .env real (já está no .gitignore).

DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-gerada-localmente
DEBUG=True

# Hosts e origens confiados, separados por vírgula. Vazio recusa toda
# requisição — por isso são obrigatórios fora de desenvolvimento.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS exige esquema (https://) e é usado pelo Django para
# validar a origem de requisições que alteram estado (POST/PUT/DELETE) atrás
# de proxy reverso. Exemplo em produção: https://app.seudominio.com.br
DJANGO_CSRF_TRUSTED_ORIGINS=

# String de conexão no formato esperado pelo django-environ.
# BL-50 (DE-014): com DEBUG=False, esta variável é OBRIGATÓRIA e precisa
# apontar para PostgreSQL — a aplicação recusa subir sem isso, porque
# SQLite não suporta a escrita concorrente de ~50 usuários simultâneos.
# Sem esta variável e com DEBUG=True, a aplicação usa SQLite local (apenas
# para desenvolvimento) e avisa isso no startup.
DATABASE_URL=postgres://dataledger:dataledger@db:5432/dataledger

# Usados apenas pelo serviço "db" do docker-compose para criar o banco inicial.
POSTGRES_DB=dataledger
POSTGRES_USER=dataledger
POSTGRES_PASSWORD=dataledger
